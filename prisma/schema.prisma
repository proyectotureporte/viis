generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ContactRequest {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String   @db.VarChar(120)
  email                 String?  @db.VarChar(320)
  phone                 String?  @db.VarChar(30)
  city                  String?  @db.VarChar(120)
  message               String   @db.Text
  source                String   @default("web") @db.VarChar(120)
  status                String   @default("NEW") @db.VarChar(24)
  ipHash                String?  @db.Char(64)
  notificationStatus    String   @default("PENDING") @db.VarChar(24)
  notificationMessageId String?  @db.VarChar(120)
  notificationError     String?  @db.VarChar(500)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([ipHash, createdAt])
  @@map("contact_requests")
}
