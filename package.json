{
  "name": "viis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Landing de OpenV — captación de crédito de vivienda y acompañamiento a damnificados del sismo del 10-ago-2026.",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.4.2",
    "lucide-react": "1.42.0",
    "next": "16.3.4",
    "nodemailer": "7.0.11",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "@types/nodemailer": "7.0.11",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.4",
    "prisma": "7.10.0",
    "typescript": "6.0.2",
    "vitest": "5.0.0"
  }
}
