# Base de datos
DATABASE_URL=postgresql://viis_copia_user:password@localhost:5432/viis_copia_db
# Solo lectura sobre contact_requests del landing viis.app (sincronización de leads; opcional)
LANDING_DATABASE_URL=

# App
NODE_ENV=production
PORT=4012
APP_URL=https://app.viis.app
# openssl rand -hex 32
AUTH_SECRET=
# openssl rand -base64 32 — ¡respaldar fuera del servidor! Sin ella no se pueden leer los datos cifrados.
DATA_ENCRYPTION_KEY=

# Documentos cifrados y antivirus
STORAGE_DIR=/var/lib/viis-copia/documentos
CLAMD_SOCKET=/var/run/clamav/clamd.ctl
CLAMD_REQUIRED=true

# Correo transaccional
SMTP_HOST=sh12.hostdime.com.co
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contacto@viis.app
SMTP_PASSWORD=
EMAIL_FROM_NAME=OpenV
EMAIL_TO=gerencia@viis.app

# Identificación legal del responsable del tratamiento (se muestra en /legal)
LEGAL_NAME=OpenV
LEGAL_NIT=
LEGAL_ADDRESS=
LEGAL_EMAIL=contacto@viis.app
